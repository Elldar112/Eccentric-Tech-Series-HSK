		<jobString>Making 20x105mm Charged cartridges.</jobString>
		<ingredients>
			<li>
				<filter>
					<categories>
						<li>SLDBar</li>
					</categories>
				</filter>
				<count>24</count>
			</li>
			<li>
				<filter>
					<categories>
						<li>USLDBar</li>
					</categories>
				</filter>
				<count>18</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>BiosyntheticMaterial</li>
					</thingDefs>
				</filter>
				<count>2</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<categories>
				<li>SLDBar</li>
				<li>USLDBar</li>
			</categories>
			<thingDefs>
				<li>BiosyntheticMaterial</li>
			</thingDefs>
		</fixedIngredientFilter>
		<products>
			<Ammo_20x105mmCharged>60</Ammo_20x105mmCharged>
		</products>
		<workAmount>3620</workAmount>
	</RecipeDef>

